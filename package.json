{
  "name": "tabby-ai-cli-launcher",
  "version": "0.1.0",
  "description": "Launch local AI CLI tools (Claude Code, Codex, etc.) from a Tabby toolbar button, with a settings page to configure the list.",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal",
    "ai",
    "cli",
    "claude",
    "claude-code",
    "codex"
  ],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build": "webpack --progress --color --mode production",
    "watch": "webpack --progress --color --watch --mode development",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuangChenning/tabby-ai-cli-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/HuangChenning/tabby-ai-cli-launcher/issues"
  },
  "homepage": "https://github.com/HuangChenning/tabby-ai-cli-launcher#readme",
  "author": "HuangChenning <huangcn1984@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "@types/node": "^18.19.0",
    "rxjs": "^7.3.0",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "ts-loader": "^9.4.0",
    "typescript": "^4.9.5",
    "webpack": "^5.24.4",
    "webpack-cli": "^4.5.0"
  }
}
